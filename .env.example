# This URL is public and will be included in the Expo app bundle.
# It must point to your deployed WordEcho dictionary gateway.
EXPO_PUBLIC_GATEWAY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/wordecho-gateway

# Public Supabase project values. Data access is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# RevenueCat public SDK keys. These identify the app/store and are safe to bundle.
# Never put a RevenueCat secret API key in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key

# Public legal pages shown from the subscription screen. Both are required for release.
EXPO_PUBLIC_TERMS_URL=https://your-domain.example/terms
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy

# Public support contact used by Help & Support in Settings.
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
