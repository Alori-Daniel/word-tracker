{
  "expo": {
    "name": "WordEcho",
    "slug": "wordecho",
    "scheme": "wordecho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/wordecho-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.danori.wordecho",
      "supportsTablet": true
    },
    "android": {
      "package": "com.danori.wordecho",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F1",
        "foregroundImage": "./assets/branding/wordecho-android-foreground.png",
        "monochromeImage": "./assets/branding/wordecho-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.danori.wordecho.widgets",
          "groupIdentifier": "group.com.danori.wordecho",
          "widgets": [
            {
              "name": "WordEchoWidget",
              "displayName": "WordEcho",
              "description": "Resurface and act on words from your WordEcho library.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WordEchoWidget",
              "label": "WordEcho",
              "description": "Resurface and act on words from your WordEcho library.",
              "minWidth": "110dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-work-manager-compatibility",
      [
        "expo-notifications",
        {
          "color": "#0878B8",
          "defaultChannel": "review-reminders"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.danori.wordecho.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.danori.wordecho"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "789055c1-7960-4bae-b91d-a52a9577ba9e"
      }
    }
  }
}
